# backend/.env.example
# Copy these names into backend/.env and fill the values there.
# Placeholders only. Never put real keys in this file.
# The API loads backend/.env and no other env file.

# --- Server ---
HOST=0.0.0.0
PORT=5000
NODE_ENV=development
# false = off; true = trust one proxy hop; or a hop count (e.g. 1).
TRUST_PROXY=false

# --- Postgres pool (Supabase pooler URL, SSL, size, timeouts) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=10000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=10000
PG_SSL=require
PG_SSL_REJECT_UNAUTHORIZED=false

# --- Supabase Auth. Server only. Never send these to a client. ---
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Optional. Leave empty to verify access tokens via JWKS at
# SUPABASE_URL/auth/v1/.well-known/jwks.json. Set only for legacy HS256 tokens.
SUPABASE_JWT_SECRET=

# --- HTTP ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Push and Slack. Server only. Leave empty to keep those features off. ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
SLACK_WEBHOOK_URL=

# --- Tunables previously hardcoded in the API ---
TIMEZONE=Africa/Nairobi
BUFFER_MINUTES=5
WORK_START=08:00
WORK_END=18:00
SLOT_MINUTES=30
COMPANY_DOMAIN=
CRON_TZ=Africa/Nairobi
REMINDER_CRON_SCHEDULE=* * * * *
TICKET_CRON_SCHEDULE=*/5 * * * *
JOIN_NOW_SMS=false
ENDING_10_EMAIL=false
SLA_AT_RISK_MINUTES=30
TICKET_REOPEN_DAYS=7
APP_NAME=Boardroom Booking
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
RESET_TOKEN_MINUTES=30
APP_URL=http://localhost:5173
RESET_DEV_LINK=false
MIN_PASSWORD_LENGTH=8

# --- Seed admin (npm run seed:admin). Password is a secret; never commit a real value.
# API startup allows an empty password; seed:admin does not. ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_PHONE=
ALLOW_PROD_SEED=false
